{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/daily-attendance-cron",
      "schedule": "30 13 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
